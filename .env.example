# Copy to .env and fill in. Never commit .env.
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone who has it,
# so only public keys belong there. Everything else stays on the voice server.

# --- App (public, bundled into the Expo app) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Defaults to port 8787 on the machine running the Expo dev server.
# EXPO_PUBLIC_VOICE_SERVER_URL=http://192.168.1.20:8787

# --- Supabase (server-side) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# --- Voice server (secret) ---
# Gemini voice design and narrator previews.
GOOGLE_API_KEY=
# Anthropic API key for roster and segment extraction (CLAUDE_API_KEY also works).
ECHO_API_KEY=

# --- Voice server (optional) ---
# 127.0.0.1 keeps the server local-only (safe on shared networks); 0.0.0.0 lets a phone on your Wi-Fi reach it.
VOICE_SERVER_HOST=127.0.0.1
# VOICE_SERVER_PORT=8787
# Uncomment only to override the defaults. Left empty, these would be read as "" and break the server.
# CLAUDE_MODEL=claude-sonnet-5-5
# NARRATOR_GEMINI_MODEL=gemini-3.8-flash-lite-tts
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# --- Database test scripts (scripts/test-db) ---
TEST_USER1_EMAIL=test-user1@example.com
TEST_USER1_PASSWORD=replace-with-test-user1-password
TEST_USER2_EMAIL=test-user2@example.com
TEST_USER2_PASSWORD=replace-with-test-user2-password
